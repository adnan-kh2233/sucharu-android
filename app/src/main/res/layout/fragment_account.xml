<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_cream"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/account_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your Sucharu account" android:textColor="@color/brand_ink" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:id="@+id/account_intro" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:lineSpacingExtra="2dp" android:text="Sign in to request a service and see your bookings." android:textColor="@color/brand_muted" android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView android:id="@+id/account_form_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="@color/brand_surface" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/brand_line" app:strokeWidth="1dp">
            <LinearLayout android:id="@+id/account_form_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:id="@+id/account_mode_tabs" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/show_login" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Sign in" />
                    <Button android:id="@+id/show_register" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Create account" />
                </LinearLayout>
                <EditText android:id="@+id/login_identifier" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:background="@drawable/bg_input" android:hint="Phone number or email" android:inputType="text" android:paddingHorizontal="12dp" android:singleLine="true"  android:textColor="#173C34" android:textColorHint="#82938E" android:includeFontPadding="true" />
                <EditText android:id="@+id/login_password" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_input" android:hint="Password" android:inputType="textPassword" android:paddingHorizontal="12dp" android:singleLine="true"  android:textColor="#173C34" android:textColorHint="#82938E" android:includeFontPadding="true" />
                <Button android:id="@+id/forgot_password" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:text="Forgot password?" android:textAllCaps="false" />

                <LinearLayout android:id="@+id/reset_fields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Get a one-time reset code at your registered email, then choose a new password." android:textColor="#60716C" android:textSize="14sp" />
                    <EditText android:id="@+id/reset_email" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:background="@drawable/bg_input" android:hint="Registered email address" android:inputType="textEmailAddress" android:paddingHorizontal="12dp" android:singleLine="true" android:textColor="#173C34" android:textColorHint="#82938E" />
                    <Button android:id="@+id/reset_send_code" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Send verification code" android:textAllCaps="false" />
                    <LinearLayout android:id="@+id/reset_code_fields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                        <EditText android:id="@+id/reset_code" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_input" android:hint="6-digit email code" android:inputType="number" android:maxLength="6" android:paddingHorizontal="12dp" android:singleLine="true" android:textColor="#173C34" android:textColorHint="#82938E" />
                        <EditText android:id="@+id/reset_new_password" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_input" android:hint="New password (at least 6 characters)" android:inputType="textPassword" android:paddingHorizontal="12dp" android:singleLine="true" android:textColor="#173C34" android:textColorHint="#82938E" />
                        <EditText android:id="@+id/reset_confirm_password" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_input" android:hint="Confirm new password" android:inputType="textPassword" android:paddingHorizontal="12dp" android:singleLine="true" android:textColor="#173C34" android:textColorHint="#82938E" />
                        <Button android:id="@+id/reset_complete" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Verify code and reset password" android:textAllCaps="false" />
                    </LinearLayout>
                    <Button android:id="@+id/reset_back_to_login" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Back to sign in" android:textAllCaps="false" />
                </LinearLayout>

                <LinearLayout android:id="@+id/register_fields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <EditText android:id="@+id/register_name" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_input" android:hint="Full name" android:inputType="textCapWords" android:paddingHorizontal="12dp" android:singleLine="true"  android:textColor="#173C34" android:textColorHint="#82938E" android:includeFontPadding="true" />
                    <EditText android:id="@+id/register_phone" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_input" android:hint="Bangladesh phone number" android:inputType="phone" android:paddingHorizontal="12dp" android:singleLine="true"  android:textColor="#173C34" android:textColorHint="#82938E" android:includeFontPadding="true" />
                    <EditText android:id="@+id/register_email" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_input" android:hint="Email address (required for password recovery)" android:inputType="textEmailAddress" android:paddingHorizontal="12dp" android:singleLine="true"  android:textColor="#173C34" android:textColorHint="#82938E" android:includeFontPadding="true" />
                    <EditText android:id="@+id/register_password" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_input" android:hint="Password (at least 6 characters)" android:inputType="textPassword" android:paddingHorizontal="12dp" android:singleLine="true"  android:textColor="#173C34" android:textColorHint="#82938E" android:includeFontPadding="true" />
                </LinearLayout>
                <Button android:id="@+id/submit_account" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Sign in" />
                <TextView android:id="@+id/account_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#B3261E" android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:id="@+id/account_profile_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:visibility="gone" app:cardBackgroundColor="@color/brand_surface" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/brand_line" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Signed in as" android:textColor="#60716C" android:textSize="13sp" />
                <TextView android:id="@+id/profile_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#173C34" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:id="@+id/profile_contact" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#60716C" android:textSize="14sp" />
                <Button android:id="@+id/edit_customer_profile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Edit account details" android:textAllCaps="false" />
                <LinearLayout android:id="@+id/customer_profile_editor" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <EditText android:id="@+id/profile_edit_name" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_input" android:hint="Full name" android:inputType="textCapWords" android:paddingHorizontal="12dp" android:textColor="@color/brand_ink" android:textColorHint="@color/brand_muted" />
                    <EditText android:id="@+id/profile_edit_phone" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_input" android:hint="Bangladesh mobile number" android:inputType="phone" android:paddingHorizontal="12dp" android:textColor="@color/brand_ink" android:textColorHint="@color/brand_muted" />
                    <EditText android:id="@+id/profile_edit_email" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_input" android:hint="Email address" android:inputType="textEmailAddress" android:paddingHorizontal="12dp" android:textColor="@color/brand_ink" android:textColorHint="@color/brand_muted" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Enter your current password to change phone, email or password. New password needs at least 6 characters." android:textColor="@color/brand_muted" android:textSize="12sp" />
                    <EditText android:id="@+id/profile_current_password" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/bg_input" android:hint="Current password (for phone/email/password changes)" android:inputType="textPassword" android:paddingHorizontal="12dp" android:textColor="@color/brand_ink" android:textColorHint="@color/brand_muted" />
                    <EditText android:id="@+id/profile_new_password" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/bg_input" android:hint="New password (at least 6 characters)" android:inputType="textPassword" android:paddingHorizontal="12dp" android:textColor="@color/brand_ink" android:textColorHint="@color/brand_muted" />
                    <EditText android:id="@+id/profile_confirm_password" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/bg_input" android:hint="Confirm new password" android:inputType="textPassword" android:paddingHorizontal="12dp" android:textColor="@color/brand_ink" android:textColorHint="@color/brand_muted" />
                    <Button android:id="@+id/save_customer_profile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Save account details" android:textAllCaps="false" />
                    <TextView android:id="@+id/profile_edit_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/brand_muted" android:textSize="13sp" />
                </LinearLayout>
                <TextView android:id="@+id/profile_address_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@color/brand_soft_green" android:padding="12dp" android:text="No saved service address yet." android:textColor="@color/brand_ink" android:textSize="13sp" />
                <Button android:id="@+id/edit_saved_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Add / edit saved address" />
                <LinearLayout android:id="@+id/saved_address_editor" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Your phone and email are account identifiers. Change them only after verification is added." android:textColor="@color/brand_muted" android:textSize="12sp" />
                    <Spinner android:id="@+id/profile_address_area" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_input" android:paddingHorizontal="8dp" />
                    <EditText android:id="@+id/profile_address_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_input" android:gravity="top" android:hint="House, road and full address" android:inputType="textCapSentences|textMultiLine" android:minLines="2" android:padding="12dp" android:textColor="@color/brand_ink" android:textColorHint="@color/brand_muted" />
                    <EditText android:id="@+id/profile_address_landmark" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_input" android:hint="Nearby landmark (optional)" android:inputType="textCapSentences" android:paddingHorizontal="12dp" android:textColor="@color/brand_ink" android:textColorHint="@color/brand_muted" />
                    <Button android:id="@+id/pick_address_pin" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Choose pin on OpenStreetMap" />
                    <TextView android:id="@+id/profile_address_pin_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Pin optional — coordinates help the service team find your entrance." android:textColor="@color/brand_muted" android:textSize="12sp" />
                    <Button android:id="@+id/save_saved_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Save address" />
                    <TextView android:id="@+id/profile_address_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/brand_muted" android:textSize="13sp" />
                    <Button android:id="@+id/remove_saved_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Remove saved address" />
                </LinearLayout>
                <Button android:id="@+id/view_my_bookings" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="View my bookings" />
                <Button android:id="@+id/sign_out" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sign out" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
