<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_cream"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="20dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_home_hero"
            android:elevation="2dp"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingVertical="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/brand_green_dark"
                android:letterSpacing="0.08"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="KHULNA  ·  HOME &amp; OFFICE"
                android:textColor="@color/brand_lime"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="2dp"
                android:text="আপনার প্রয়োজনীয় সেবা,\nএক জায়গায়"
                android:textColor="@color/brand_surface"
                android:textSize="27sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"
                android:text="সহজে service বেছে request পাঠান। Availability ও final price আমরা নিশ্চিত করব।"
                android:textColor="#E8F1E8"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:background="@color/brand_soft_green"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="11dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌖" android:textColor="@color/brand_green" android:textSize="19sp" android:textStyle="bold" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Sonadanga · Khulna Sadar · Khalishpur · Daulatpur"
                android:textColor="@color/brand_ink"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/services_section_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="26dp"
            android:letterSpacing="0.12"
            android:text="SUCHARU SERVICES"
            android:textColor="@color/brand_green"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="4dp"
            android:text="কোন সেবাটি দরকার?"
            android:textColor="@color/brand_ink"
            android:textSize="22sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/service_search"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="10dp"
            android:hint="Search services"
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:textColor="@color/brand_ink"
            android:textColorHint="@color/brand_muted"
            android:textSize="14sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">
            <LinearLayout android:id="@+id/category_filters" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/catalog_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="12dp"
            android:text="Loading services…"
            android:textColor="@color/brand_muted"
            android:textSize="13sp" />
        <LinearLayout android:id="@+id/service_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/pricing_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/brand_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/brand_line"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pricing &amp; payments" android:textColor="@color/brand_ink" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:lineSpacingExtra="2dp" android:text="দেখানো দাম starting estimate। কাজের scope ও materials দেখে final price আগে জানানো হবে।" android:textColor="@color/brand_muted" android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
