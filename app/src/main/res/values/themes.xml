<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Sucharu" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/brand_green</item>
        <item name="colorPrimaryVariant">@color/brand_green_dark</item>
        <item name="colorOnPrimary">@color/brand_surface</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/brand_lime</item>
        <item name="colorSecondaryVariant">@color/brand_lime</item>
        <item name="colorOnSecondary">@color/brand_ink</item>
        <item name="colorSurface">@color/brand_surface</item>
        <item name="colorOnSurface">@color/brand_ink</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/brand_green_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.Sucharu.NoActionBar" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_green</item>
        <item name="colorPrimaryVariant">@color/brand_green_dark</item>
        <item name="colorOnPrimary">@color/brand_surface</item>
        <item name="colorSecondary">@color/brand_lime</item>
        <item name="colorOnSecondary">@color/brand_ink</item>
        <item name="colorSurface">@color/brand_surface</item>
        <item name="colorOnSurface">@color/brand_ink</item>
        <item name="android:statusBarColor">@color/brand_green_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="buttonStyle">@style/Widget.Sucharu.Button</item>
        <item name="materialButtonStyle">@style/Widget.Sucharu.Button</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Widget.Sucharu.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>


    <style name="Theme.Sucharu.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.Sucharu.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>
